deployment {
  production = environment "Home Lab" {
    #homelab

    networkZone = zone "Network Infrastructure" {
      gatewayAppliance = appliance "UDM-SE" {
        udm = instanceOf homelab.networkPlatform.gateway
      }
      coreSwitching = appliance "Core and Access Switching" {
        aggregation = instanceOf homelab.networkPlatform.aggregation
        pro48 = instanceOf homelab.networkPlatform.pro48
        proXg24 = instanceOf homelab.networkPlatform.proXg24
        xg6 = instanceOf homelab.networkPlatform.xg6
        edge = instanceOf homelab.networkPlatform.accessSwitches
      }
      wireless = appliance "Wireless and LoRaWAN" {
        accessPoints = instanceOf homelab.networkPlatform.accessPoints
        lorawan = instanceOf homelab.networkPlatform.lorawanGateway
      }
    }

    dnsZone = zone "Coupled DNS and Proxy High Availability" {
      nodeA = server "Node A: j1-svpihole0" {
        keepalived = instanceOf homelab.dnsPlatform.node1.keepalived
        pihole = instanceOf homelab.dnsPlatform.node1.pihole
        unbound = instanceOf homelab.dnsPlatform.node1.unbound
        lighttpd = instanceOf homelab.dnsPlatform.node1.lighttpd
        caddy = instanceOf homelab.dnsPlatform.node1.caddy
        lsyncd = instanceOf homelab.dnsPlatform.node1.lsyncd
        publisher = instanceOf homelab.dnsPlatform.node1.publisher
        finalizer = instanceOf homelab.dnsPlatform.node1.finalizer
        reconciler = instanceOf homelab.dnsPlatform.node1.reconciler
        queue = instanceOf homelab.dnsPlatform.node1.notificationQueue
        worker = instanceOf homelab.dnsPlatform.node1.notificationWorker
      }
      nodeB = server "Node B: j1-svpihole00" {
        keepalived = instanceOf homelab.dnsPlatform.node2.keepalived
        pihole = instanceOf homelab.dnsPlatform.node2.pihole
        unbound = instanceOf homelab.dnsPlatform.node2.unbound
        lighttpd = instanceOf homelab.dnsPlatform.node2.lighttpd
        caddy = instanceOf homelab.dnsPlatform.node2.caddy
        lsyncd = instanceOf homelab.dnsPlatform.node2.lsyncd
        publisher = instanceOf homelab.dnsPlatform.node2.publisher
        finalizer = instanceOf homelab.dnsPlatform.node2.finalizer
        reconciler = instanceOf homelab.dnsPlatform.node2.reconciler
        queue = instanceOf homelab.dnsPlatform.node2.notificationQueue
        worker = instanceOf homelab.dnsPlatform.node2.notificationWorker
      }
      coupledVips = appliance "PIHOLE_DUALSTACK shared VIPs" {
        group = instanceOf homelab.dnsPlatform.ownershipGroup
        dnsVips = instanceOf homelab.dnsPlatform.virtualIp
        proxyVips = instanceOf homelab.dnsPlatform.proxyVirtualIp
      }
    }

    servicesZone = zone "Application Services" {
      monitoringHost = server "Monitoring Host" {
        prometheus = instanceOf homelab.observability.prometheus
        grafana = instanceOf homelab.observability.grafana
        alertmanager = instanceOf homelab.observability.alertmanager
        cadvisor = instanceOf homelab.observability.cadvisor
        nodeExporter = instanceOf homelab.observability.nodeExporter
        munin = instanceOf homelab.observability.munin
      }
      notificationHost = server "Notification Host" {
        appriseApi = instanceOf homelab.notificationPlatform.appriseApi
        mailrise = instanceOf homelab.notificationPlatform.mailrise
        configStore = instanceOf homelab.notificationPlatform.configStore
      }
      automationHost = server "Automation Host" {
        nebulaTimer = instanceOf homelab.automation.nebulaTimer
        nebulaSync = instanceOf homelab.automation.nebulaSync
        ntpServer = instanceOf homelab.timePlatform.ntpServer
      }
    }

    managementZone = zone "Management Workstation" {
      operatorWorkstation = workstation "Operator Workstation" {
        terraform = instanceOf homelab.automation.terraform
        serverConfiguration = instanceOf homelab.automation.serverConfiguration
        windowsWslScripts = instanceOf homelab.automation.windowsWslScripts
      }
    }

    externalZone = zone "External Dependencies" {
      dnsUpstream = appliance "Cloudflare DNS-over-TLS" {
        resolver = instanceOf cloudflareDns
      }
      secretStore = appliance "Doppler TLS source" {
        tls = instanceOf homelab.dnsPlatform.tlsMaterial
      }
      deliveryProviders = appliance "Notification Providers" {
        providers = instanceOf notificationProviders
      }
    }
  }
}
